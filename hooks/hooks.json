{
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/korean-stop.py", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/guard-bash.py", "timeout": 25 } ] },
      { "matcher": "Edit|Write|MultiEdit", "hooks": [ { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/no-new-comments.py", "timeout": 5 } ] },
      { "matcher": "Bash|AskUserQuestion|SendUserFile|mcp__ccd_turn__wrap_up|mcp__ccd_turn__update_plan", "hooks": [ { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/tool-text.py", "timeout": 5 } ] }
    ]
  }
}
